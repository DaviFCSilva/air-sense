{
  "version": 1,
  "author": "AirSense - Grupo 12",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "board-ssd1306",
      "id": "oled",
      "top": -100,
      "left": 150,
      "attrs": { "i2cAddress": "0x3c" }
    },
    {
      "type": "wokwi-dht22",
      "id": "dht",
      "top": -120,
      "left": -110,
      "attrs": { "temperature": "24.5", "humidity": "55" }
    },
    { "type": "wokwi-potentiometer", "id": "pot_co2", "top": 30, "left": 170, "attrs": {} },
    { "type": "wokwi-potentiometer", "id": "pot_dust", "top": 120, "left": 170, "attrs": {} },
    { "type": "wokwi-potentiometer", "id": "pot_press", "top": 210, "left": 170, "attrs": {} },
    { "type": "wokwi-led", "id": "led_g", "top": 300, "left": -60, "attrs": { "color": "green" } },
    { "type": "wokwi-led", "id": "led_y", "top": 300, "left": 0, "attrs": { "color": "yellow" } },
    { "type": "wokwi-led", "id": "led_r", "top": 300, "left": 60, "attrs": { "color": "red" } },
    {
      "type": "wokwi-resistor",
      "id": "r_g",
      "top": 250,
      "left": -60,
      "rotate": 90,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_y",
      "top": 250,
      "left": 0,
      "rotate": 90,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_r",
      "top": 250,
      "left": 60,
      "rotate": 90,
      "attrs": { "value": "220" }
    },
    { "type": "wokwi-buzzer", "id": "bz", "top": 300, "left": 130, "attrs": { "volume": "0.1" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "oled:VCC", "esp:3V3", "red", [] ],
    [ "oled:GND", "esp:GND.2", "black", [] ],
    [ "oled:SCL", "esp:22", "green", [] ],
    [ "oled:SDA", "esp:21", "blue", [] ],
    [ "dht:VCC", "esp:3V3", "red", [] ],
    [ "dht:GND", "esp:GND.1", "black", [] ],
    [ "dht:SDA", "esp:15", "orange", [] ],
    [ "pot_co2:VCC", "esp:3V3", "red", [] ],
    [ "pot_co2:GND", "esp:GND.2", "black", [] ],
    [ "pot_co2:SIG", "esp:34", "purple", [] ],
    [ "pot_dust:VCC", "esp:3V3", "red", [] ],
    [ "pot_dust:GND", "esp:GND.2", "black", [] ],
    [ "pot_dust:SIG", "esp:35", "gray", [] ],
    [ "pot_press:VCC", "esp:3V3", "red", [] ],
    [ "pot_press:GND", "esp:GND.2", "black", [] ],
    [ "pot_press:SIG", "esp:32", "brown", [] ],
    [ "esp:25", "r_g:1", "green", [] ],
    [ "r_g:2", "led_g:A", "green", [] ],
    [ "led_g:C", "esp:GND.3", "black", [] ],
    [ "esp:26", "r_y:1", "yellow", [] ],
    [ "r_y:2", "led_y:A", "yellow", [] ],
    [ "led_y:C", "esp:GND.3", "black", [] ],
    [ "esp:27", "r_r:1", "red", [] ],
    [ "r_r:2", "led_r:A", "red", [] ],
    [ "led_r:C", "esp:GND.3", "black", [] ],
    [ "esp:33", "bz:2", "magenta", [] ],
    [ "bz:1", "esp:GND.3", "black", [] ]
  ],
  "dependencies": {}
