# Copie para api/.env e troque o valor. O .env NÃO vai para o Git.
# A mesma chave deve ir em API_KEY no firmware/airsense/secrets.h.
# Para gerar uma chave aleatória:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
API_KEY=troque-esta-chave

# Opcional: caminho do banco SQLite (padrão: api/airsense.db)
# AIRSENSE_DB=airsense.db
